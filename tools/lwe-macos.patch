 }
 
+void DynamicValue::setAnimation (KeyframeAnimation animation) {
+    if (animation.channels.empty ()) {
+	return;
+    }
+
+    this->m_animationBase = this->m_vec4;
+    this->m_animation = std::move (animation);
+    animatedValues ().insert (this);
+}
+
+void DynamicValue::animateAll (float time) {
+    for (auto* value : animatedValues ()) {
+	value->animate (time);
+    }
+}
+
+void DynamicValue::animate (float time) {
+    const auto& animation = *this->m_animation;
+    float frame = time * animation.fps;
+
+    if (animation.length > 0.0f) {
+	switch (animation.mode) {
+	    case KeyframeAnimation::Single: frame = std::min (frame, animation.length); break;
+	    case KeyframeAnimation::Mirror: {
+		const float cycle = std::fmod (frame, animation.length * 2.0f);
+		frame = cycle > animation.length ? animation.length * 2.0f - cycle : cycle;
+		break;
+	    }
+	    default: frame = std::fmod (frame, animation.length); break;
+	}
+    }
+
+    glm::vec4 result = {};
+    for (size_t i = 0; i < animation.channels.size () && i < 4; i++) {
+	result[i] = evaluateCurve (animation.channels[i], frame);
+    }
+
+    if (animation.relative) {
+	result += this->m_animationBase;
+    }
+
+    switch (animation.channels.size ()) {
+	case 1: this->update (result.x, UpdateSource::Script); break;
+	case 2: this->update (glm::vec2 (result), UpdateSource::Script); break;
+	case 3: this->update (glm::vec3 (result), UpdateSource::Script); break;
+	default: this->update (result, UpdateSource::Script); break;
+    }
+}
