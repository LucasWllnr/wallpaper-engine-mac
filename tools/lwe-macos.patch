+// Wallpaper Engine compiles shaders like HLSL, where a vec4 silently truncates to a smaller vector (e.g. a vec4
+// v_TexCoord used as texture coordinates, or a vec4 multiplied by a vec2). GLSL rejects that, so on every line
+// glslang reports, un-swizzled vec4 identifiers get the swizzle of the size the error message expects.
+// It also tolerates a stray #endif, which is dropped here.
+std::string repairImplicitTruncation (const std::string& source, const std::string& infoLog) {
+    static const std::regex errorLine (
+	R"(ERROR: 0:(\d+): .*(wrong operand types|cannot convert|no matching overloaded function).*)"
+    );
+    static const std::regex components (R"(([123])-component)");
+    static const std::regex declaration (R"(\bvec4\s+(\w+))");
+
+    std::vector<std::string> lines;
+    std::stringstream stream (source);
+    for (std::string line; std::getline (stream, line);) {
+	lines.push_back (line);
+    }
+
+    std::vector<std::string> names;
+    for (std::sregex_iterator it (source.begin (), source.end (), declaration), end; it != end; ++it) {
+	names.push_back ((*it)[1]);
+    }
+
+    bool changed = false;
+
+    // a stray #endif is ignored by Wallpaper Engine's preprocessor
+    static const std::regex strayEndif (R"(ERROR: 0:(\d+): '#endif' : mismatched statements)");
+    for (std::sregex_iterator it (infoLog.begin (), infoLog.end (), strayEndif), end; it != end; ++it) {
+	if (const size_t index = std::stoul ((*it)[1]) - 1; index < lines.size () && !lines[index].empty ()) {
+	    lines[index].clear ();
+	    changed = true;
+	}
+    }
+
+    for (std::sregex_iterator it (infoLog.begin (), infoLog.end (), errorLine), end; it != end; ++it) {
+	const size_t index = std::stoul ((*it)[1]) - 1;
+	if (index >= lines.size ()) {
+	    continue;
+	}
+
+	const std::string message = (*it)[0];
+	std::smatch size;
+	const std::string swizzle = std::regex_search (message, size, components)
+	    ? std::string ("xyz").substr (0, std::stoi (size[1]))
+	    : "xy";
+
+	for (const auto& name : names) {
+	    // skip the declaration itself and anything already swizzled or indexed
+	    if (std::regex_search (lines[index], std::regex ("\\bvec4\\s+" + name + "\\b"))) {
+		continue;
+	    }
+
+	    const std::string repaired = std::regex_replace (
+		lines[index], std::regex ("\\b" + name + "\\b(?!\\s*[.\\[(])"), name + "." + swizzle
+	    );
+	    changed |= repaired != lines[index];
+	    lines[index] = repaired;
+	}
+    }
+
+    if (!changed) {
+	return source;
+    }
+
+    std::string result;
+    for (const auto& line : lines) {
+	result += line + "\n";
+    }
+    return result;
+}
