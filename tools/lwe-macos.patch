+namespace {
+std::set<DynamicValue*>& animatedValues () {
+    static std::set<DynamicValue*> values;
+    return values;
+}
+
+float evaluateCurve (const std::vector<KeyframeAnimation::Keyframe>& keys, float frame) {
+    if (keys.empty ()) {
+	return 0.0f;
+    }
+
+    if (frame <= keys.front ().frame) {
+	return keys.front ().value;
+    }
+
+    if (frame >= keys.back ().frame) {
+	return keys.back ().value;
+    }
+
+    const auto next = std::upper_bound (
+	keys.begin (), keys.end (), frame,
+	[] (float f, const KeyframeAnimation::Keyframe& key) { return f < key.frame; }
+    );
+    const auto& a = *std::prev (next);
+    const auto& b = *next;
+    const float span = b.frame - a.frame;
+
+    if (span <= 0.0f) {
+	return b.value;
+    }
+
+    if (!a.frontEnabled && !b.backEnabled) {
+	return glm::mix (a.value, b.value, (frame - a.frame) / span);
+    }
+
+    // cubic bezier through the tangent handles; handle x is relative to a third of the segment
+    const glm::vec2 p0 { a.frame, a.value };
+    const glm::vec2 p3 { b.frame, b.value };
+    const glm::vec2 p1 = a.frontEnabled ? p0 + glm::vec2 (a.front.x * span / 3.0f, a.front.y)
+					: p0 + (p3 - p0) / 3.0f;
+    const glm::vec2 p2 = b.backEnabled ? p3 + glm::vec2 (b.back.x * span / 3.0f, b.back.y)
+				       : p3 - (p3 - p0) / 3.0f;
+    const auto bezier = [&] (float t) {
+	const float u = 1.0f - t;
+	return u * u * u * p0 + 3.0f * u * u * t * p1 + 3.0f * u * t * t * p2 + t * t * t * p3;
+    };
+
+    // solve x(t) = frame by bisection, x is monotonic for sane handles
+    float low = 0.0f, high = 1.0f;
+    for (int i = 0; i < 24; i++) {
+	const float mid = (low + high) / 2.0f;
+	(bezier (mid).x < frame ? low : high) = mid;
+    }
+
+    return bezier ((low + high) / 2.0f).y;
+}
+}
