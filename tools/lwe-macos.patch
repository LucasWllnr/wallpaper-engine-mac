@@ -3,8 +3,60 @@
 #include "UserSettingParser.h"
 #include "WallpaperEngine/Data/Model/DynamicValue.h"
 
+#include <algorithm>
+
 using namespace WallpaperEngine::Data::Parsers;
 
+namespace {
+// {"c0": [{"frame", "value", "back": {"x", "y", "enabled"}, "front": {...}}], "c1": ..., "options": {...}}
+KeyframeAnimation parseAnimation (const json& data) {
+    KeyframeAnimation animation;
+
+    if (const auto optionsIt = data.find ("options"); optionsIt != data.end () && optionsIt->is_object ()) {
+	animation.fps = optionsIt->value ("fps", 30.0f);
+	animation.length = optionsIt->value ("length", 0.0f);
+
+	const std::string mode = optionsIt->value ("mode", std::string ("loop"));
+	animation.mode = mode == "single" ? KeyframeAnimation::Single
+	    : mode == "mirror"	       ? KeyframeAnimation::Mirror
+				       : KeyframeAnimation::Loop;
+    }
+
+    animation.relative = data.value ("relative", false);
+
+    const auto handle = [] (const json& key, const char* name, glm::vec2& out, bool& enabled) {
+	const auto it = key.find (name);
+	enabled = it != key.end () && it->is_object () && it->value ("enabled", false);
+	out = enabled ? glm::vec2 (it->value ("x", 0.0f), it->value ("y", 0.0f)) : glm::vec2 (0.0f);
+    };
+
+    for (int channel = 0; channel < 4; channel++) {
+	const auto curveIt = data.find ("c" + std::to_string (channel));
+
+	if (curveIt == data.end () || !curveIt->is_array ()) {
+	    break;
+	}
+
+	std::vector<KeyframeAnimation::Keyframe> keys;
+
+	for (const auto& key : *curveIt) {
+	    KeyframeAnimation::Keyframe keyframe {
+		.frame = key.value ("frame", 0.0f),
+		.value = key.value ("value", 0.0f),
+	    };
+	    handle (key, "back", keyframe.back, keyframe.backEnabled);
+	    handle (key, "front", keyframe.front, keyframe.frontEnabled);
+	    keys.push_back (keyframe);
+	}
+
+	std::ranges::sort (keys, {}, &KeyframeAnimation::Keyframe::frame);
+	animation.channels.push_back (std::move (keys));
+    }
+
+    return animation;
+}
+}
