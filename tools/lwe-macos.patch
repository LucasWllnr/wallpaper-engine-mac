+	sLog.error ("GLSL ", kind, " unit parsing Failed: ", shader->getInfoLog ());
+	// LWE_SHADER_DEBUG=<dir>: keep the preprocessed source that failed, to find the offending line
+	if (const char* dumpDir = getenv ("LWE_SHADER_DEBUG"); dumpDir != nullptr) {
+	    std::ofstream (std::string (dumpDir) + "/failed-" + std::to_string (std::hash<std::string> {} (source)) + "." + kind)
+		<< source;
+	}
+	return nullptr;
+    }
+}
